{
  "name": "fuel-cap",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config playwright.admin.config.ts",
    "quality:performance": "node scripts/check-performance-budget.mjs",
    "quality:manifest": "node scripts/create-release-manifest.mjs",
    "quality:smoke": "node scripts/verify-production-smoke.mjs",
    "workspace:build": "corepack pnpm build && corepack pnpm --filter @fuelcap/admin build && corepack pnpm --filter landing-page build",
    "workspace:lint": "turbo run lint",
    "workspace:typecheck": "turbo run typecheck"
  },
  "engines": {
    "node": "22.22.x"
  },
  "overrides": {
    "postcss": "^8.5.12",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^1.26.0",
    "next": "16.3.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@axe-core/playwright": "^4.10.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "turbo": "2.10.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
