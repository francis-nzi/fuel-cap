# Control Room sign-in: the STAFF Supabase project (separate from the customer project). See docs/ADMIN_AUTH.md.
ADMIN_SUPABASE_URL=https://your-staff-project.supabase.co
ADMIN_SUPABASE_ANON_KEY=your-staff-project-publishable-key
# Secret: server only.
ADMIN_SUPABASE_SERVICE_ROLE_KEY=your-staff-project-secret-key
# Secret: 48+ random characters. Signs the idle-clock and step-up cookies.
ADMIN_SESSION_SECRET=replace-with-48-plus-random-characters
ADMIN_SITE_URL=https://fuelcap-app.onrender.com
# Never set these outside the E2E suite: ADMIN_E2E, ADMIN_DATA_BACKEND, ADMIN_E2E_SEED
